# Tusmaal — one Next.js app on Vercel, database on Neon.
# Copy this file to .env and fill in the values. Never commit the real .env.

# Neon pooled connection string (host contains "-pooler").
# Dashboard → Connect → Connection string.
DATABASE_URL=

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Brand and public URL (no trailing slash). On Vercel set this to the live domain.
PLATFORM_NAME=Tusmaal
NEXT_PUBLIC_PLATFORM_NAME=Tusmaal
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Email (leave blank to log and skip sends)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Mux video (lesson uploads). Leave blank until video hosting is ready.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Optional. Local disk is used when this is false.
# On Vercel the disk does not keep files — turn this on for photos and PDFs.
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Protects the daily reminder job: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-string
REMINDER_INACTIVE_DAYS=3

# Optional pool tuning
# DB_POOL_MAX=5
# DB_CONNECTION_TIMEOUT_MS=10000
# DATABASE_SSL=false
